# Infura project API key (Base mainnet must be enabled for the key)
INFURA_API_KEY=
# Optional: override the RPC URL entirely (defaults to Infura)
BASE_RPC_URL=

# Monitor (scripts/monitor.js) tuning, all optional
# A token counts as "just deployed" if it had no contract code this many minutes before its pool was created
MAX_TOKEN_AGE_MIN=60

# Telegram alerts
# Create a bot with @BotFather. For a channel, add the bot as admin and use @channelname or the numeric id (-100...).
# Run `npm run telegram:test` without TELEGRAM_CHAT_ID to list the chats the bot can see.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Master switch for the alerts: true (default) or false. Takes effect on the next monitor run (every minute).
# When false the monitor keeps working and writing data/, it just does not send anything (manual tests still work).
TELEGRAM_ENABLED=true

# Risk filters (all optional; defaults shown). Score-based: see docs/FILTERS.md
MIN_LIQUIDITY_USD=1000
MIN_SCORE=40
MAX_TAX_PCT=25
DEX_WAIT_MIN=5

# Comma-separated addresses of LP locker contracts you trust (their LP counts as locked)
LOCKER_ADDRESSES=
